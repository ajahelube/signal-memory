# Spend Guard (SERV Hackathon 02). Copy to .env and fill in. Never commit real values.
SERV_API_KEY=            # OpenServ SERV Reasoning key (OPENSERV_API_KEY also works)
SERV_MODEL=serv-mini     # optional
SPEND_GUARD_HARD_CAP=0.05
KITE_MODE=dry-run        # dry-run (default, nothing is paid) or kpass (real payments via the kpass CLI)
KITE_PAY_URL=https://hermes.swap.io/v1/swap/quote
